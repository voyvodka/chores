    "Chores": {
      "shouldTranslate": false
    },
    "Chores checks once a day for a newer release tag, builds it on this Mac and installs it. A running job postpones the install until it ends.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chores günde bir kez daha yeni bir sürüm etiketi var mı bakar, onu bu Mac'te derler ve kurar. Çalışan bir job varsa kurulum o bitene kadar bekler."
          }
        }
      }
    },
    "Chores could not update to %@": {
